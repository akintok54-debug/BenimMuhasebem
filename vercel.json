{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/", "destination": "/erp/login.html", "permanent": false },
    { "source": "/giris", "destination": "/erp/login.html", "permanent": false },
    { "source": "/login", "destination": "/erp/login.html", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/api", "destination": "/api" }
  ]
}
