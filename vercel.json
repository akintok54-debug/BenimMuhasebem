{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/ideasoft-siparisleri",
      "schedule": "0 3 * * *"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "benimmuhasebe.com"
        }
      ],
      "headers": {
        "Location": "https://www.benimmuhasebe.com/$1"
      },
      "status": 308
    },
    {
      "src": "/(?:giris|login)?/?",
      "headers": {
        "Location": "/erp/login.html"
      },
      "status": 307
    },
    {
      "src": "/platform(?:/.*)?",
      "dest": "/api"
    },
    {
      "src": "/admin(?:/.*)?",
      "dest": "/api"
    },
    {
      "src": "/.*%.*",
      "dest": "/api"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/api(?:/.*)?",
      "dest": "/api"
    }
  ]
}
