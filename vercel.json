{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [],
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "benimmuhasebe.com"
        }
      ],
      "headers": {
        "Location": "https://www.benimmuhasebe.com/$1"
      },
      "status": 308
    },
    {
      "src": "/(?:giris|login)?/?",
      "headers": {
        "Location": "/erp/login.html"
      },
      "status": 307
    },
    {
      "src": "/platform(?:/.*)?",
      "dest": "/api"
    },
    {
      "src": "/admin(?:/.*)?",
      "dest": "/api"
    },
    {
      "src": "/.*%.*",
      "dest": "/api"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/api(?:/.*)?",
      "dest": "/api"
    }
  ],
  "git": {
    "deploymentEnabled": false
  },
  "buildCommand": "npm run check",
  "installCommand": "npm ci",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{src/**,public/**,node_modules/xlsx/dist/xlsx.full.min.js,node_modules/jszip/dist/jszip.min.js}"
    }
  }
}
