PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/<database>?retryWrites=true&w=majority
JWT_SECRET=<en-az-32-rastgele-bayt>
JWT_EXPIRES_IN=8h
JWT_ISSUER=benimmuhasebe-api
JWT_AUDIENCE=benimmuhasebe-web
JWT_ALLOW_LEGACY=false
CORS_ORIGINS=https://erp.example.com
ENCRYPTION_KEY=<en-az-32-rastgele-bayt-jwt-den-farkli>
BACKUP_ENCRYPTION_KEY=<en-az-32-rastgele-bayt-digerlerinden-farkli>
BACKUP_DIR=./backups
RESTORE_TEST_MONGODB_URI=mongodb+srv://<restore-user>:<password>@<test-cluster>/<isolated-test-db>?retryWrites=true&w=majority
REDIS_URL=rediss://<redis-user>:<redis-password>@<redis-host>:6380
SECURITY_ALERT_WEBHOOK=https://security-alerts.example.com/webhook
PUBLIC_APP_URL=https://www.benimmuhasebe.com
# Opsiyonel deployment override'ı. Doluysa IdeaSoft yalnızca bu tenant ObjectId'sinde açılır.
IDEASOFT_AKN_TENANT_ID=
BREVO_API_KEY=<brevo-api-v3-key>
BREVO_SENDER_EMAIL=noreply@benimmuhasebe.com
BREVO_SENDER_NAME=BenimMuhasebe
RESEND_API_KEY=<resend-api-key-opsiyonel>
PASSWORD_RESET_EMAIL_FROM=BenimMuhasebe <noreply@example.com>
