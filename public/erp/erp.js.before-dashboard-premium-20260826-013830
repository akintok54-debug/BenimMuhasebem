            setTitle(page);
            content.innerHTML = `
                <div class="dashboard-panel">
                    <h2>${escapeHtml(page)}</h2>
                    <div class="empty-state">
                        Bu modül için arayüz yeniden kuruluyor.
                    </div>
                </div>
            `;
            return;
        }

        setTitle(cfg.title);
        loading();

        try {
            const data = await api(cfg.url);

            content.innerHTML = table(
                cfg.title,
                data[cfg.key] || [],
                cfg.columns
            );
        } catch (error) {
            errorBox(error);
        }
    }

