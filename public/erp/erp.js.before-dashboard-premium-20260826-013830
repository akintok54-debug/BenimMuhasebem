                        <thead>
                            <tr>
                                ${columns.map(c => `<th>${escapeHtml(c.label)}</th>`).join("")}
                            </tr>
                        </thead>
                        <tbody>
                            ${list.map(row => `
                                <tr>
                                    ${columns.map(c => `
                                        <td>${escapeHtml(
                                            typeof c.value === "function"
